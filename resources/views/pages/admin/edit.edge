<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Upravit uživatele</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>

  <main class="container">

    <div class="header">
      <div>
        <h1>Upravit uživatele</h1>
        <p class="subtitle">
          Úprava uživatelského účtu
        </p>
      </div>
    </div>

    <div class="form-card">

      <form method="POST" action="/admin/users/{{ user.id }}/update">
        {{ csrfField() }}

        <div class="form-group">
          <label for="fullName">Jméno</label>
          <input
            type="text"
            id="fullName"
            name="fullName"
            value="{{ user.fullName || '' }}"
            minlength="2"
            required
          >
        </div>

        <div class="form-group">
          <label for="email">E-mail</label>
          <input
            type="email"
            id="email"
            name="email"
            value="{{ user.email }}"
            required
          >
        </div>

        <div class="form-group">
          <label for="role">Role</label>
          <select id="role" name="role">
            <option value="user" @if(user.role === 'user') selected @endif>
              Uživatel
            </option>
            <option value="admin" @if(user.role === 'admin') selected @endif>
              Administrátor
            </option>
          </select>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">
            Uložit změny
          </button>

          <a href="/admin/users" class="btn">
            Zrušit
          </a>
        </div>

      </form>

    </div>

  </main>

</body>
</html>
