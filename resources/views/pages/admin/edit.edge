
<!DOCTYPE html>
<html lang="cs"> <!-- Český jazyk -->
<head>
  <meta charset="UTF-8"> <!-- České znaky -->
  <meta name="viewport" content="width=device-width, initial-scale=1.0"> <!-- Mobilní zobrazení -->
  <title>Upravit uživatele</title> <!-- Název stránky -->
  <link rel="stylesheet" href="/css/admin.css"> <!-- Připojení CSS -->
</head>
<body>

  <main class="container"> <!-- Hlavní obsah -->

    <div class="header"> <!-- Hlavička -->
      <div>
        <h1>Upravit uživatele</h1> <!-- Nadpis -->
        <p class="subtitle"> <!-- Popis stránky -->
          Úprava uživatelského účtu
        </p>
      </div>
    </div>

    <div class="form-card"> <!-- Vzhled formuláře -->

      <form method="POST" action="/admin/users/{{ user.id }}/update"> <!-- Uložení změn -->
        {{ csrfField() }} <!-- CSRF ochrana -->

        <div class="form-group"> <!-- Úprava jména -->
          <label for="fullName">Jméno</label> <!-- Popisek -->
          <input
            type="text"
            id="fullName"
            name="fullName"
            value="{{ user.fullName || '' }}"
            minlength="2"
            required
          > <!-- Původní jméno -->
        </div>

        <div class="form-group"> <!-- Úprava e-mailu -->
          <label for="email">E-mail</label> <!-- Popisek -->
          <input
            type="email"
            id="email"
            name="email"
            value="{{ user.email }}"
            required
          > <!-- Původní e-mail -->
        </div>

        <div class="form-group"> <!-- Úprava role -->
          <label for="role">Role</label> <!-- Popisek -->
          <select id="role" name="role"> <!-- Výběr role -->
            <option value="user" @if(user.role === 'user') selected @endif>
              Uživatel
            </option>
            <option value="admin" @if(user.role === 'admin') selected @endif>
              Administrátor
            </option>
          </select>
        </div>

        <div class="form-actions"> <!-- Tlačítka formuláře -->
          <button type="submit" class="btn btn-primary"> <!-- Uložení změn -->
            Uložit změny
          </button>

          <a href="/admin/users" class="btn"> <!-- Zrušení -->
            Zrušit
          </a>
        </div>

      </form>

    </div>

  </main>

</body>
</html>
