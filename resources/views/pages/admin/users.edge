<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8">
  <title>Správa uživatelů</title>
</head>
<body>
  <h1>Správa uživatelů</h1>

  <a href="/dashboard">Zpět na dashboard</a>

  <h2>Seznam uživatelů</h2>
  <p><a href="/admin/users/create">+ Přidat uživatele</a></p>

  <table border="1" cellpadding="10">
    <thead>
      <tr>
        <th>ID</th>
        <th>Jméno</th>
        <th>E-mail</th>
        <th>Role</th>
        <th>Akce</th>
      </tr>
    </thead>
    <tbody>
      @each(user in users)
        <tr>
          <td>{{ user.id }}</td>
          <td>{{ user.fullName || 'Neuvedeno' }}</td>
          <td>{{ user.email }}</td>
          <td>{{ user.role }}</td>

          <td>
            <a href="/admin/users/{{ user.id }}/edit">
              Upravit
            </a>

            <form
              method="POST"
              action="/admin/users/{{ user.id }}/delete"
              style="display: inline;"
              onsubmit="return confirm('Opravdu chceš smazat tohoto uživatele?')"
            >
              {{ csrfField() }}

              <button type="submit">
                Smazat
              </button>
            </form>
          </td>

        </tr>
      @end
    </tbody>
  </table>
</body>
</html>
