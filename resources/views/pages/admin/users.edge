<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8">
  <title>Správa uživatelů</title>
</head>
<body>
  <h1>Správa uživatelů</h1>

  <a href="/dashboard">Zpět na dashboard</a>

  <h2>Seznam uživatelů</h2>

  <table border="1" cellpadding="10">
    <thead>
      <tr>
        <th>ID</th>
        <th>Jméno</th>
        <th>E-mail</th>
        <th>Role</th>
      </tr>
    </thead>
    <tbody>
      @each(user in users)
        <tr>
          <td>{{ user.id }}</td>
          <td>{{ user.fullName || 'Neuvedeno' }}</td>
          <td>{{ user.email }}</td>
          <td>{{ user.role }}</td>
        </tr>
      @end
    </tbody>
  </table>
</body>
</html>
