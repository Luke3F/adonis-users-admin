
<!DOCTYPE html>
<html lang="cs"> <!-- Český jazyk -->
<head>
  <meta charset="UTF-8"> <!-- České znaky -->
  <meta name="viewport" content="width=device-width, initial-scale=1.0"> <!-- Mobilní zobrazení -->
  <title>Přidat uživatele</title> <!-- Název stránky -->
  <link rel="stylesheet" href="/css/admin.css"> <!-- Připojení CSS -->
</head>
<body>

  <main class="container"> <!-- Hlavní obsah -->

    <div class="header"> <!-- Hlavička -->
      <div>
        <h1>Přidat uživatele</h1> <!-- Nadpis -->
        <p class="subtitle"> <!-- Popis stránky -->
          Vytvoření nového uživatelského účtu
        </p>
      </div>
    </div>

    <div class="form-card"> <!-- Vzhled formuláře -->

      <form method="POST" action="/admin/users"> <!-- Odeslání údajů -->
        {{ csrfField() }} <!-- CSRF ochrana -->

        <div class="form-group"> <!-- Pole jména -->
          <label for="fullName">Jméno</label> <!-- Popisek -->
          <input
            type="text"
            id="fullName"
            name="fullName"
            minlength="2"
            required
          > <!-- Povinné jméno -->
        </div>

        <div class="form-group"> <!-- Pole e-mailu -->
          <label for="email">E-mail</label> <!-- Popisek -->
          <input
            type="email"
            id="email"
            name="email"
            required
          > <!-- Povinný e-mail -->
        </div>

        <div class="form-group"> <!-- Pole hesla -->
          <label for="password">Heslo</label> <!-- Popisek -->
          <input
            type="password"
            id="password"
            name="password"
            minlength="8"
            required
          > <!-- Heslo alespoň 8 znaků -->
        </div>

        <div class="form-group"> <!-- Výběr role -->
          <label for="role">Role</label> <!-- Popisek -->
          <select id="role" name="role"> <!-- Nabídka rolí -->
            <option value="user">Uživatel</option> <!-- Běžný účet -->
            <option value="admin">Administrátor</option> <!-- Admin účet -->
          </select>
        </div>

        <div class="form-actions"> <!-- Tlačítka formuláře -->
          <button type="submit" class="btn btn-primary"> <!-- Vytvoření účtu -->
            Vytvořit uživatele
          </button>

          <a href="/admin/users" class="btn"> <!-- Zrušení -->
            Zrušit
          </a>
        </div>

      </form>

    </div>

  </main>

</body>
</html>
